# служебное
.venv/
__pycache__/
*.pyc
.DS_Store

# тяжёлые промежуточные файлы: пересобираются скриптами студии
studio/assets/audio/*.wav
studio/out/*.wav
studio/out/preview_*.jpg
studio/out/_*.mp4
studio/out/*-silent.mp4

# out — производные результаты; в Git только актуальный ролик и постер.
# Исходники и библиотеки персонажей хранятся вне out.
studio/out/*
!studio/out/README.md
!studio/out/pilot-letter-p.mp4
!studio/out/pilot-letter-p-poster.jpg

# личные референсы семьи: только локально (см. studio/reference/README.md)
studio/reference/*
!studio/reference/README.md
