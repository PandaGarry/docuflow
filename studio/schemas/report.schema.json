{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "quality_report"
    },
    "scope": {
      "const": "technical_smoke_only"
    },
    "status": {
      "enum": [
        "passed",
        "failed"
      ]
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "passed": {
            "type": "boolean"
          },
          "detail": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "passed",
          "detail"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "metrics": {
      "type": "object"
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    }
  },
  "required": [
    "schema_version",
    "kind",
    "scope",
    "status",
    "checks",
    "metrics",
    "limitations"
  ],
  "additionalProperties": false
}
