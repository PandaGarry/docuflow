{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 2
    },
    "kind": {
      "const": "asset_package"
    },
    "asset_id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "string",
      "minLength": 1
    },
    "art_status": {
      "const": "unreviewed"
    },
    "coordinate_system": {
      "const": "RH_Z_UP_METERS"
    },
    "forward_axis": {
      "const": "+Y"
    },
    "blend": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "collection": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "path",
        "sha256",
        "collection"
      ],
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "properties": {
        "authoring_script": {
          "type": "string",
          "minLength": 1
        },
        "script_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "license": {
          "const": "project-original"
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "path",
              "sha256"
            ],
            "additionalProperties": false
          },
          "maxItems": 32
        }
      },
      "required": [
        "authoring_script",
        "script_sha256",
        "license"
      ],
      "additionalProperties": false
    },
    "bindings": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "properties": {
          "type": {
            "enum": [
              "OBJECT_LOCATION",
              "OBJECT_ROTATION",
              "POSE_ROTATION",
              "SHAPE_KEY"
            ]
          },
          "object": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "type",
          "object"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "type": {
                  "enum": [
                    "POSE_ROTATION",
                    "SHAPE_KEY"
                  ]
                }
              }
            },
            "then": {
              "required": [
                "target"
              ]
            }
          }
        ]
      }
    },
    "ik_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "armature": {
            "type": "string",
            "minLength": 1
          },
          "bone": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "armature",
          "bone",
          "target"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "rotation_unit": {
      "const": "radian"
    },
    "contact_probes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "object": {
            "type": "string",
            "minLength": 1
          },
          "vertex_indices": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            },
            "minItems": 1,
            "maxItems": 128,
            "uniqueItems": true
          },
          "ground_z": {
            "type": "number"
          }
        },
        "required": [
          "id",
          "object",
          "vertex_indices",
          "ground_z"
        ],
        "additionalProperties": false
      }
    },
    "fingertip_probes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "object": {
            "type": "string",
            "minLength": 1
          },
          "vertex_indices": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            },
            "minItems": 1,
            "maxItems": 128,
            "uniqueItems": true
          },
          "armature": {
            "type": "string",
            "minLength": 1
          },
          "reference_bone": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "object",
          "vertex_indices",
          "armature",
          "reference_bone"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "kind",
    "asset_id",
    "revision",
    "art_status",
    "coordinate_system",
    "forward_axis",
    "blend",
    "provenance",
    "bindings",
    "ik_checks",
    "rotation_unit"
  ],
  "additionalProperties": false
}
