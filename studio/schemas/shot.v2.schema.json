{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 2
    },
    "kind": {
      "const": "shot"
    },
    "shot_id": {
      "type": "string",
      "minLength": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "asset_id": {
      "type": "string",
      "minLength": 1
    },
    "asset_revision": {
      "type": "string",
      "minLength": 1
    },
    "frame_range": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0
      },
      "minItems": 2,
      "maxItems": 2
    },
    "tracks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "control": {
            "type": "string",
            "minLength": 1
          },
          "keys": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "properties": {
                "frame": {
                  "type": "integer",
                  "minimum": 0
                },
                "value": {
                  "oneOf": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "array",
                      "items": {
                        "type": "number"
                      },
                      "minItems": 3,
                      "maxItems": 3
                    }
                  ]
                }
              },
              "required": [
                "frame",
                "value"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "control",
          "keys"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "contacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "probe": {
            "type": "string",
            "minLength": 1
          },
          "frame_range": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            },
            "minItems": 2,
            "maxItems": 2
          }
        },
        "required": [
          "probe",
          "frame_range"
        ],
        "additionalProperties": false
      }
    },
    "finger_checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "probe": {
            "type": "string",
            "minLength": 1
          },
          "min_span_m": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 0.3
          }
        },
        "required": [
          "probe",
          "min_span_m"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "kind",
    "shot_id",
    "project_id",
    "asset_id",
    "asset_revision",
    "frame_range",
    "tracks"
  ],
  "additionalProperties": false
}
