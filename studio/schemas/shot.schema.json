{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "shot"
    },
    "shot_id": {
      "type": "string",
      "minLength": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "asset_id": {
      "type": "string",
      "minLength": 1
    },
    "rig_id": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "const": "technical_smoke"
    },
    "frame_range": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0
      },
      "minItems": 2,
      "maxItems": 2
    },
    "tracks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "control": {
            "type": "string",
            "minLength": 1
          },
          "keys": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "frame": {
                  "type": "integer",
                  "minimum": 0
                },
                "value": {
                  "oneOf": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "array",
                      "items": {
                        "type": "number"
                      },
                      "minItems": 3,
                      "maxItems": 3
                    }
                  ]
                }
              },
              "required": [
                "frame",
                "value"
              ],
              "additionalProperties": false
            },
            "minItems": 2
          }
        },
        "required": [
          "control",
          "keys"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "schema_version",
    "kind",
    "shot_id",
    "project_id",
    "asset_id",
    "rig_id",
    "purpose",
    "frame_range",
    "tracks"
  ],
  "additionalProperties": false
}
